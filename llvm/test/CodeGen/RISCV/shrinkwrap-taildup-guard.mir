# RUN: llc -mtriple=riscv64 -run-pass=tailduplication -verify-machineinstrs \
# RUN:     -tail-dup-size=8 -riscv-shrink-wrapping-dataflow=true %s -o - \
# RUN:     | FileCheck %s
#
# Post-RA TailDuplication may run with shrink-frame, but must never duplicate
# Prolog into a no-frame predecessor (including layout-pred merge/splice).
# Preds of Prolog must not be simple jump-only blocks: those are legally
# redirected to Prolog (no-frame -> Prolog) and then deleted.

---
name:            reject_prolog_taildup_into_noframe
tracksRegLiveness: true
frameInfo:
  stackSize:       16
  adjustsStack:    true
  hasCalls:        true
  prolog:          '%bb.3'
body:             |
  bb.0:
    liveins: $x10
    successors: %bb.1, %bb.2
    BNE $x10, $x0, %bb.1
    PseudoBR %bb.2

  bb.1:
    liveins: $x10
    successors: %bb.3
    ; Not a layout predecessor of Prolog (bb.2 sits between).
    $x11 = ADDI $x10, 1
    PseudoBR %bb.3

  bb.2:
    liveins: $x10
    successors: %bb.3
    $x12 = ADDI $x10, 2
    PseudoBR %bb.3

  bb.3:
    liveins: $x10
    $x2 = frame-setup ADDI $x2, -16
    $x10 = ADDI $x10, 5
    PseudoRET implicit $x10

...

# CHECK-LABEL: name: reject_prolog_taildup_into_noframe
# No-frame unique insns stay outside Prolog; FrameSetup is not copied into them.
# CHECK: $x11 = ADDI $x10, 1
# CHECK-NOT: frame-setup
# CHECK: $x12 = ADDI $x10, 2
# CHECK-NOT: frame-setup
# CHECK: $x2 = frame-setup ADDI $x2, -16
# CHECK-NOT: frame-setup

---
name:            reject_prolog_merge_into_layout_pred
tracksRegLiveness: true
frameInfo:
  stackSize:       16
  adjustsStack:    true
  hasCalls:        true
  prolog:          '%bb.2'
body:             |
  bb.0:
    liveins: $x10
    successors: %bb.1
    PseudoBR %bb.1

  bb.1:
    liveins: $x10
    successors: %bb.2
    ; Sole predecessor and layout predecessor of Prolog.
    $x11 = ADDI $x10, 1
    PseudoBR %bb.2

  bb.2:
    liveins: $x10
    $x2 = frame-setup ADDI $x2, -16
    $x10 = ADDI $x10, 5
    PseudoRET implicit $x10

...

# CHECK-LABEL: name: reject_prolog_merge_into_layout_pred
# Merge-into-prev must not splice FrameSetup into the no-frame layout pred.
# CHECK: $x11 = ADDI $x10, 1
# CHECK-NOT: frame-setup
# CHECK: $x2 = frame-setup ADDI $x2, -16
# CHECK-NOT: frame-setup

---
name:            allow_inframe_taildup
tracksRegLiveness: true
frameInfo:
  stackSize:       16
  adjustsStack:    true
  hasCalls:        true
  prolog:          '%bb.1'
body:             |
  bb.0:
    liveins: $x10
    successors: %bb.1
    PseudoBR %bb.1

  bb.1:
    liveins: $x10
    successors: %bb.2, %bb.3
    $x2 = frame-setup ADDI $x2, -16
    BNE $x10, $x0, %bb.3
    PseudoBR %bb.2

  bb.2:
    liveins: $x10
    successors: %bb.4
    ; In-frame uncond pred of the shared tail; not layout successor of bb.4.
    $x11 = ADDI $x10, 7
    PseudoBR %bb.4

  bb.3:
    liveins: $x10
    successors: %bb.4
    $x12 = ADDI $x10, 9
    PseudoBR %bb.4

  bb.4:
    liveins: $x10
    $x10 = ADDI $x10, 42
    $x2 = frame-destroy ADDI $x2, 16
    PseudoRET implicit $x10

...

# CHECK-LABEL: name: allow_inframe_taildup
# In-frame tail may be duplicated into the non-layout predecessor.
# CHECK-DAG: $x11 = ADDI $x10, 7
# CHECK-DAG: $x10 = ADDI $x10, 42
# CHECK-DAG: $x12 = ADDI $x10, 9
# CHECK-DAG: $x10 = ADDI $x10, 42
