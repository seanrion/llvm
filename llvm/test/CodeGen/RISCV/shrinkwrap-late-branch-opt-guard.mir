# RUN: llc -mtriple=riscv64 -run-pass=riscv-late-branch-opt -verify-machineinstrs \
# RUN:     -riscv-shrink-wrapping-dataflow=true %s -o - | FileCheck %s
#
# Shrink-frame LateBranchOpt (scheme C): no whole-function getProlog() skip.
# Constant-foldable branches may collapse when the remaining edge is legal
# (same-side / no-frame→Prolog). Uses BEQ $x0,$x0 (isFromLoadImm only sees
# X0 / vregs post-RA).

--- |
  define void @fold_in_framed_region(i64 %x) {
    ret void
  }

  define void @fold_in_noframe_region(i64 %x) {
    ret void
  }

  define void @fold_noframe_to_prolog(i64 %x) {
    ret void
  }
...
---
name:            fold_in_framed_region
tracksRegLiveness: true
frameInfo:
  stackSize:       16
  adjustsStack:    true
  hasCalls:        true
  prolog:          '%bb.1'
body:             |
  bb.0:
    liveins: $x10
    successors: %bb.1
    PseudoBR %bb.1

  bb.1:
    liveins: $x10
    successors: %bb.2, %bb.3
    $x2 = frame-setup ADDI $x2, -16
    ; Always taken: collapse to unconditional jump to bb.3 (same framed region).
    BEQ $x0, $x0, %bb.3
    PseudoBR %bb.2

  bb.2:
    liveins: $x10
    $x10 = ADDI $x0, 1
    $x2 = frame-destroy ADDI $x2, 16
    PseudoRET

  bb.3:
    liveins: $x10
    $x10 = ADDI $x0, 2
    $x2 = frame-destroy ADDI $x2, 16
    PseudoRET

...
---
name:            fold_in_noframe_region
tracksRegLiveness: true
frameInfo:
  stackSize:       16
  adjustsStack:    true
  hasCalls:        true
  prolog:          '%bb.3'
body:             |
  bb.0:
    liveins: $x10
    successors: %bb.1, %bb.2
    ; Always taken no-frame→no-frame: must still fold (pass not skipped).
    BEQ $x0, $x0, %bb.2
    PseudoBR %bb.1

  bb.1:
    liveins: $x10
    successors: %bb.3
    PseudoBR %bb.3

  bb.2:
    PseudoRET

  bb.3:
    liveins: $x10
    $x2 = frame-setup ADDI $x2, -16
    $x10 = ADDI $x0, 9
    $x2 = frame-destroy ADDI $x2, 16
    PseudoRET

...
---
# Remaining edge is no-frame → Prolog: RejectEdge must allow the fold.
name:            fold_noframe_to_prolog
tracksRegLiveness: true
frameInfo:
  stackSize:       16
  adjustsStack:    true
  hasCalls:        true
  prolog:          '%bb.2'
body:             |
  bb.0:
    liveins: $x10
    successors: %bb.1, %bb.2
    BEQ $x0, $x0, %bb.2
    PseudoBR %bb.1

  bb.1:
    PseudoRET

  bb.2:
    liveins: $x10
    $x2 = frame-setup ADDI $x2, -16
    $x10 = ADDI $x0, 3
    $x2 = frame-destroy ADDI $x2, 16
    PseudoRET

...

# CHECK-LABEL: name: fold_in_framed_region
# CHECK: $x2 = frame-setup ADDI $x2, -16
# CHECK-NOT: BEQ $x0, $x0
# CHECK: PseudoBR %bb.3
# CHECK: $x2 = frame-destroy ADDI $x2, 16

# CHECK-LABEL: name: fold_in_noframe_region
# CHECK-NOT: BEQ $x0, $x0
# CHECK: PseudoBR %bb.2
# CHECK: $x2 = frame-setup ADDI $x2, -16

# CHECK-LABEL: name: fold_noframe_to_prolog
# CHECK-NOT: BEQ $x0, $x0
# CHECK: PseudoBR %bb.2
# CHECK: $x2 = frame-setup ADDI $x2, -16
