# RUN: llc -mtriple=riscv64 -run-pass=livedebugvalues \
# RUN:     -riscv-shrink-wrapping-dataflow=true %s -o - | FileCheck %s
#
# Shrink-frame must not whole-function-skip LiveDebugValues.
# - Register locations still propagate on no-frame paths.
# - FrameDestroy kills SpillLocs (and emits undef).
# - No-frame merge blocks must not keep SP-relative spill DBG_VALUEs.
#
# isInFrameRegion = dom(Prolog, BB). A successor of Prolog is still in-frame,
# so "prolog → next BB" is NOT a no-frame join; use FrameDestroy / diamond merge.

--- |
  define void @allow_reg_prop_with_shrink_frame(i64 %x) !dbg !5 {
  entry:
    call void @llvm.dbg.value(metadata i64 %x, metadata !9, metadata !DIExpression()), !dbg !11
    ret void
  }

  define void @spill_killed_by_frame_destroy(i64 %x) !dbg !12 {
  entry:
    call void @llvm.dbg.value(metadata i64 %x, metadata !14, metadata !DIExpression()), !dbg !15
    ret void
  }

  define void @spill_not_into_noface_merge(i64 %x) !dbg !17 {
  entry:
    call void @llvm.dbg.value(metadata i64 %x, metadata !19, metadata !DIExpression()), !dbg !20
    ret void
  }

  declare void @llvm.dbg.value(metadata, metadata, metadata)

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}
  !llvm.ident = !{!4}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, enums: !6)
  !1 = !DIFile(filename: "ldv-sf.c", directory: "/")
  !2 = !{i32 2, !"Dwarf Version", i32 4}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = !{!"clang"}
  !5 = distinct !DISubprogram(name: "allow_reg_prop_with_shrink_frame", scope: !1, file: !1, line: 1, type: !7, scopeLine: 1, flags: DIFlagPrototyped, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !8)
  !6 = !{}
  !7 = !DISubroutineType(types: !16)
  !8 = !{!9}
  !9 = !DILocalVariable(name: "x", arg: 1, scope: !5, file: !1, line: 1, type: !10)
  !10 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !11 = !DILocation(line: 1, column: 1, scope: !5)
  !12 = distinct !DISubprogram(name: "spill_killed_by_frame_destroy", scope: !1, file: !1, line: 2, type: !7, scopeLine: 2, flags: DIFlagPrototyped, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !13)
  !13 = !{!14}
  !14 = !DILocalVariable(name: "x", arg: 1, scope: !12, file: !1, line: 2, type: !10)
  !15 = !DILocation(line: 2, column: 1, scope: !12)
  !16 = !{null, !10}
  !17 = distinct !DISubprogram(name: "spill_not_into_noface_merge", scope: !1, file: !1, line: 3, type: !7, scopeLine: 3, flags: DIFlagPrototyped, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !18)
  !18 = !{!19}
  !19 = !DILocalVariable(name: "x", arg: 1, scope: !17, file: !1, line: 3, type: !10)
  !20 = !DILocation(line: 3, column: 1, scope: !17)
...
---
name:            allow_reg_prop_with_shrink_frame
tracksRegLiveness: true
frameInfo:
  stackSize:       16
  adjustsStack:    true
  hasCalls:        true
  prolog:          '%bb.1'
body:             |
  bb.0:
    liveins: $x10
    successors: %bb.1, %bb.2
    DBG_VALUE $x10, $noreg, !9, !DIExpression(), debug-location !11
    BEQ $x10, $x0, %bb.2
    PseudoBR %bb.1

  bb.1:
    liveins: $x10
    $x2 = frame-setup ADDI $x2, -16
    $x2 = frame-destroy ADDI $x2, 16
    PseudoRET

  bb.2:
    liveins: $x10
    PseudoRET

...

# CHECK-LABEL: name: allow_reg_prop_with_shrink_frame
# CHECK: bb.2:
# CHECK: DBG_VALUE $x10, $noreg, !{{[0-9]+}}, !DIExpression()
# CHECK: PseudoRET

---
name:            spill_killed_by_frame_destroy
tracksRegLiveness: true
stack:
  - { id: 0, name: '', type: spill-slot, offset: -8, size: 8, alignment: 8,
      stack-id: default }
frameInfo:
  stackSize:       16
  adjustsStack:    true
  hasCalls:        true
  prolog:          '%bb.1'
body:             |
  bb.0:
    liveins: $x10
    successors: %bb.1
    PseudoBR %bb.1

  bb.1:
    liveins: $x10
    $x2 = frame-setup ADDI $x2, -16
    DBG_VALUE $x10, $noreg, !14, !DIExpression(), debug-location !15
    ; RISCV isStoreToStackSlot requires FI + imm 0.
    SD killed renamable $x10, %stack.0, 0 :: (store (s64) into %stack.0)
    $x2 = frame-destroy ADDI $x2, 16
    PseudoRET

...

# CHECK-LABEL: name: spill_killed_by_frame_destroy
# CHECK: DBG_VALUE $x10, $noreg, !{{[0-9]+}}, !DIExpression()
# CHECK: SD killed renamable $x10, %stack.0, 0
# Spill transfer creates an SP-relative location.
# CHECK: DBG_VALUE $x2
# FrameDestroy must terminate it with an undef DBG_VALUE.
# CHECK: frame-destroy ADDI $x2, 16
# CHECK-NEXT: DBG_VALUE $noreg, $noreg, !{{[0-9]+}}, !DIExpression()
# CHECK: PseudoRET

---
name:            spill_not_into_noface_merge
tracksRegLiveness: true
stack:
  - { id: 0, name: '', type: spill-slot, offset: -8, size: 8, alignment: 8,
      stack-id: default }
frameInfo:
  stackSize:       16
  adjustsStack:    true
  hasCalls:        true
  prolog:          '%bb.1'
body:             |
  bb.0:
    liveins: $x10
    successors: %bb.1, %bb.2
    ; Early no-frame path + framed path merge at bb.3 (bb.3 not dominated by Prolog).
    BEQ $x10, $x0, %bb.2
    PseudoBR %bb.1

  bb.1:
    liveins: $x10
    successors: %bb.3
    $x2 = frame-setup ADDI $x2, -16
    DBG_VALUE $x10, $noreg, !19, !DIExpression(), debug-location !20
    SD killed renamable $x10, %stack.0, 0 :: (store (s64) into %stack.0)
    $x2 = frame-destroy ADDI $x2, 16
    PseudoBR %bb.3

  bb.2:
    liveins: $x10
    successors: %bb.3
    DBG_VALUE $x10, $noreg, !19, !DIExpression(), debug-location !20
    PseudoBR %bb.3

  bb.3:
    PseudoRET

...

# CHECK-LABEL: name: spill_not_into_noface_merge
# Framed path did produce an SP-relative spill DBG_VALUE.
# CHECK: bb.1:
# CHECK: DBG_VALUE $x2
# No-frame merge must not carry that spill location.
# CHECK: bb.3:
# CHECK-NOT: DBG_VALUE $x2
# CHECK: PseudoRET
